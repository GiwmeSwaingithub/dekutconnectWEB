{
  "version": 2,
  "name": "dekutconnect",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/blog/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/blog/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/blog/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/blog/fonts/(.*)",
      "dest": "/public/fonts/$1"
    },
    {
      "src": "/blog/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/blog/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/blog/posts.json",
      "dest": "/public/posts.json"
    },
    {
      "src": "/blog/editor\\.html",
      "dest": "/public/editor.html"
    },
    {
      "src": "/blog/editor",
      "dest": "/public/editor.html"
    },
    {
      "src": "/blog/dmca\\.html",
      "dest": "/public/dmca.html"
    },
    {
      "src": "/blog/dmca",
      "dest": "/public/dmca.html"
    },
    {
      "src": "/blog/post\\.html",
      "dest": "/public/post.html"
    },
    {
      "src": "/blog/post",
      "dest": "/public/post.html"
    },
    {
      "src": "/blog/(.+)",
      "dest": "/server.js"
    },
    {
      "src": "/blog/?",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
