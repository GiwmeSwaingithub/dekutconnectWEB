{
  "version": 2,
  "name": "dekutconnect",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/go/oraimo/?$",
      "status": 302,
      "headers": { "Location": "https://ke.oraimo.com?affiliate_code=5g0mo32v" }
    },
    {
      "src": "^/oraimo/shop/?$",
      "status": 302,
      "headers": { "Location": "https://ke.oraimo.com?affiliate_code=5g0mo32v" }
    },
    {
      "src": "^/partnership/oraimo/shop/?$",
      "status": 302,
      "headers": { "Location": "https://ke.oraimo.com?affiliate_code=5g0mo32v" }
    },
    {
      "src": "^/go/oraimo-app/?$",
      "status": 302,
      "headers": { "Location": "https://ke.oraimo.com/download-app.html?utm_source=oraimo&utm_medium=invite&invite_code=0tws6pdekutconnect&deeplink=%7B%22target_type%22%3A17%2C%22keyword%22%3A%220tws6pdekutconnect%22%7D" }
    },
    {
      "src": "^/oraimo/app/?$",
      "status": 302,
      "headers": { "Location": "https://ke.oraimo.com/download-app.html?utm_source=oraimo&utm_medium=invite&invite_code=0tws6pdekutconnect&deeplink=%7B%22target_type%22%3A17%2C%22keyword%22%3A%220tws6pdekutconnect%22%7D" }
    },
    {
      "src": "^/partnership/oraimo/app/?$",
      "status": 302,
      "headers": { "Location": "https://ke.oraimo.com/download-app.html?utm_source=oraimo&utm_medium=invite&invite_code=0tws6pdekutconnect&deeplink=%7B%22target_type%22%3A17%2C%22keyword%22%3A%220tws6pdekutconnect%22%7D" }
    },
    {
      "src": "^/oraimo/?$",
      "status": 301,
      "headers": { "Location": "/partnership/oraimo" }
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/blog/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/blog/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/blog/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/blog/fonts/(.*)",
      "dest": "/public/fonts/$1"
    },
    {
      "src": "/blog/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/blog/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/blog/posts.json",
      "dest": "/public/posts.json"
    },
    {
      "src": "/blog/editor\\.html",
      "dest": "/public/editor.html"
    },
    {
      "src": "/blog/editor",
      "dest": "/public/editor.html"
    },
    {
      "src": "/blog/dmca\\.html",
      "dest": "/public/dmca.html"
    },
    {
      "src": "/blog/dmca",
      "dest": "/public/dmca.html"
    },
    {
      "src": "/blog/post\\.html",
      "dest": "/public/post.html"
    },
    {
      "src": "/blog/post",
      "dest": "/public/post.html"
    },
    {
      "src": "^/partnership/oraimo/?$",
      "dest": "/public/partnership/oraimo/index.html"
    },
    {
      "src": "^/partnership/?$",
      "dest": "/public/partnership/index.html"
    },
    {
      "src": "^/blog/?$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/$",
      "dest": "/public/home.html"
    },
    {
      "src": "/blog/(.+)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
